{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Key": "THIS_IS_MY_SECRET_KEY_123456789",
    "Issuer": "MyApi",
    "Audience": "MyApiUsers",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "RefreshToken": {
    "ExpirationDays": 7
  },
  "EmailConfirmationOptions": {
    "ConfirmationUrl": "http://localhost:5241/api/identity/confirm-email"
  },
  "EmailSettings": {
    "RetryCount": 3,
    "BackoffBaseSeconds": 2,
    "TimeoutSeconds": 5
  }
}
