{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Auth": {
    "RefreshToken": {
      "ExpirationDays": 7
    },
    "Jwt": {
      "Key": "THIS_IS_MY_SECRET_KEY_123456789_SDFJKKJKDF",
      "Issuer": "MyApi",
      "Audience": "MyApi",
      "AccessTokenExpirationMinutes": 15
    }
  },
  "Notification": {
    "EmailConfirmationOptions": {
      "ConfirmationUrl": "http://localhost:5241/api/identity/confirm-email"
    },
    "EmailSettings": {
      "RetryCount": 3,
      "BackoffBaseSeconds": 2,
      "TimeoutSeconds": 5
    }
  },
  "Files": {
    "Owners": [
      {
        "Id": "organization",
        "Purposes": [
          {
            "Id": "profile-picture",
            "Policy": {
              "IsPrivate": true,
              "ValidContentTypes": [
                "image/jpeg",
                "image/png"
              ],
              "MinSize": 1024,
              "MaxSize": 5242880
            }
          }
        ]
      }
    ]
  }
}
